# bridgeforge pre-commit 闸（多段，严格执行序；详见 docs/harness-engineering-design.md §2.1）:
#   [D8] dogfood 镜像闸: templates/hooks/*.py 缺 .codex/hooks/ 对应 → exit 2; 正文差异只 stderr 软提示
#   [D6] 规则闸: rule_size 读 staged blob + rule_index 读工作树 → 违规 exit 2
#   [skills] 通用 skill metadata 闸: skills/<name>/SKILL.md 缺可调用 frontmatter → exit 2
#   [既有] memory 索引重建: 提交前重建衍生索引(_stats.json/MEMORY.md/MEMORY_COLD.md)并纳入本次提交
#          —— 卫生段，永 exit 0 兜底。杜绝"花名册欠账"溜过任意提交路径(git-sync/手动/IDE 都拦得住)。
#
# 硬闸原则: 只有明确判出违规才 exit 2; 脚本自身异常一律放行(宁漏不误伤)。
#   · exit 2 段必须在受管区块内立即退出；项目扩展位于受管区块之后，保留其原有退出码。
#   · 规则闸豁免走 CHANGELOG.md 顶部 [skip-rule-size]; 镜像闸豁免走 [dogfood-exempt: <hook> <因>]。
#     (pre-commit 在 commit message 生成前触发，读不到 message，故豁免走已 staged 的 CHANGELOG 顶部)。
# Python 3.11+ hard gate: an existing project .venv is authoritative and never falls back to PATH.
find_py() {
  if [ -e .venv ]; then
    for CANDIDATE in .venv/Scripts/python.exe .venv/bin/python; do
      if [ -f "$CANDIDATE" ]; then
        if "$CANDIDATE" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 2)' >/dev/null 2>&1; then
          echo "$CANDIDATE"; return 0
        fi
        echo "[pre-commit] BLOCKED: project .venv must use Python 3.11+; PATH fallback is forbidden." >&2
        return 2
      fi
    done
    echo "[pre-commit] BLOCKED: project .venv exists but has no Python interpreter." >&2
    return 2
  fi
  for CANDIDATE in python3 python; do
    if command -v "$CANDIDATE" >/dev/null 2>&1 &&
       "$CANDIDATE" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 2)' >/dev/null 2>&1; then
      echo "$CANDIDATE"; return 0
    fi
  done
  echo "[pre-commit] BLOCKED: Python 3.11+ is required." >&2
  return 2
}
PY="$(find_py)"
PY_RC=$?
[ "$PY_RC" = 2 ] && exit 2

# ── [D8] dogfood 镜像闸(缺文件硬拦 exit 2; 正文差异只 stderr 软提示不阻断) ──
if [ -n "$PY" ] && [ -f ".codex/hooks/mirror_drift_check.py" ]; then
  "$PY" .codex/hooks/mirror_drift_check.py
  rc=$?
  [ "$rc" = 2 ] && exit 2
fi

# ── [instructions] Codex 原生 AGENTS 指令源硬闸（含 staged 公共区，防 edit+restore 绕过） ──
if [ -n "$PY" ] && [ -f ".codex/hooks/instruction_source_check.py" ]; then
  "$PY" .codex/hooks/instruction_source_check.py
  rc=$?
  [ "$rc" -eq 2 ] && exit 2
fi

# ── [hooks-source] Codex lifecycle hook 唯一注册源硬闸 ──
if [ -n "$PY" ] && [ -f ".codex/hooks/config_health_check.py" ]; then
  "$PY" .codex/hooks/config_health_check.py --strict
  rc=$?
  [ "$rc" = 2 ] && exit 2
fi

# [encoding] UTF-8 BOM is forbidden in bridgeforge-codex text surfaces.
if [ -n "$PY" ] && [ -f ".codex/hooks/encoding_check.py" ]; then
  "$PY" .codex/hooks/encoding_check.py --pre-commit
  rc=$?
  [ "$rc" = 2 ] && exit 2
fi

# ── [layout] doc 五层索引 + scripts/tests 单一测试目录硬闸 ──
if [ -n "$PY" ] && [ -f ".codex/hooks/project_structure_check.py" ]; then
  "$PY" .codex/hooks/project_structure_check.py --pre-commit
  rc=$?
  [ "$rc" = 2 ] && exit 2
fi

# ── [D6] 规则闸(硬拦; 无 python 或脚本缺失则跳过, 不阻断) ──
if [ -n "$PY" ]; then
  if [ -f ".codex/hooks/rule_size_check.py" ]; then
    "$PY" .codex/hooks/rule_size_check.py --pre-commit
    rc=$?
    [ "$rc" = 2 ] && exit 2
  fi
  if [ -f ".codex/hooks/rule_index_check.py" ]; then
    "$PY" .codex/hooks/rule_index_check.py --pre-commit
    rc=$?
    [ "$rc" = 2 ] && exit 2
  fi
fi

# ── [skills] 通用 skill metadata 闸(硬拦; 下游无 skills/ 则自门控 no-op) ──
if [ -n "$PY" ] && [ -f ".codex/hooks/skill_metadata_check.py" ]; then
  "$PY" .codex/hooks/skill_metadata_check.py --pre-commit
  rc=$?
  [ "$rc" = 2 ] && exit 2
fi

# ── [既有] memory 索引重建(卫生段, 永 exit 0 兜底) ──
SCRIPT=".codex/scripts/memory_rebuild_index.py"
if [ -n "$PY" ] && [ -f "$SCRIPT" ]; then
  "$PY" "$SCRIPT" || true
  git add .codex/memory/_stats.json .codex/memory/MEMORY.md .codex/memory/MEMORY_COLD.md 2>/dev/null || true
fi
