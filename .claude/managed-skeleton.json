{
  "schema_version": 1,
  "stamp": ".claude/.bridgeforge_version",
  "whole_files": [
    "CLAUDE.md",
    ".claude/.bridgeforge_version",
    ".claude/managed-skeleton.json",
    ".claude/hooks/*.py",
    ".claude/scripts/*.py",
    ".claude/rules/*.md",
    ".claude/settings.json"
  ],
  "managed_regions": [
    {
      "path": ".githooks/pre-commit",
      "begin": "# >>> BRIDGEFORGE_MANAGED_BEGIN",
      "end": "# <<< BRIDGEFORGE_MANAGED_END"
    }
  ]
}
